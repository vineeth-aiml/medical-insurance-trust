ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://medical_user:medical_pass@localhost:5432/medical_trust_engine
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ASYNC_PROCESSING=true
USE_MINIO=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medical-claims
MINIO_SECURE=false
OCR_ENGINE=auto
PADDLE_USE_GPU=false
SHOW_DEBUG_JSON=false
# Optional contracted verification providers
# HOSPITAL_API_BASE_URL=https://your-hospital-gateway.example.com
# HOSPITAL_API_TOKEN=replace-me
# NMC_API_BASE_URL=https://your-doctor-registry-gateway.example.com
# NMC_API_TOKEN=replace-me
